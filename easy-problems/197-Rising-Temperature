-- 197. Rising Temperature
-- Problem: Find all dates where the temperature was higher than the previous day.
-- Link: https://leetcode.com/problems/rising-temperature/
-- Difficulty: Easy
-- Description:
-- Return the IDs of the records where the temperature is higher than the previous day's temperature.

SELECT id
FROM (
    SELECT 
        *,
        LAG(recordDate) OVER (ORDER BY recordDate) AS prev_date,
        LAG(temperature) OVER (ORDER BY recordDate) AS prev_temp
    FROM Weather
) AS w
WHERE temperature > prev_temp
  AND recordDate = prev_date + INTERVAL '1 day';
